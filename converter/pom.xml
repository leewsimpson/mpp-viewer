<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.mppviewer</groupId>
  <artifactId>mpp-converter</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mpxj.version>16.11.0</mpxj.version>
    <junit.version>6.1.3</junit.version>
    <golden.update>false</golden.update>
  </properties>

  <dependencies>
    <dependency>
      <groupId>net.sf.mpxj</groupId>
      <artifactId>mpxj</artifactId>
      <version>${mpxj.version}</version>
      <!-- Libraries only used by readers/writers this viewer doesn't need. Dropping
           them takes about 19 MB off the app. Checked with jdeps against MPXJ 16.11:
             sqlite-jdbc        Primavera P6 and Asta SQLite databases (14 MB of
                                native libraries for every platform)
             jackson            MPXJ's JSON writer and P6 web services
             jgoodies-binding   MPXJ's Swing explorer GUI
             commons-math3      POI spreadsheet formula functions
           Re-check this list when upgrading MPXJ. -->
      <exclusions>
        <exclusion><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId></exclusion>
        <exclusion><groupId>com.fasterxml.jackson.core</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>com.jgoodies</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>org.apache.commons</groupId><artifactId>commons-math3</artifactId></exclusion>
      </exclusions>
    </dependency>

    <!-- Test scope: not bundled. Don't add libraries MPXJ itself might use here,
         or the tests would no longer run on the trimmed set the app ships. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>mpp-converter</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <!-- Same headless mode the app runs the converter in. -->
          <argLine>-Djava.awt.headless=true</argLine>
          <systemPropertyVariables>
            <golden.update>${golden.update}</golden.update>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- MPXJ (LGPL) and its dependencies stay as separate, unmodified jars in lib/,
           referenced from the manifest, so they can be swapped out independently. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.mppviewer.Convert</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-libs</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
